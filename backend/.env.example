# Copy this file to .env and replace every placeholder. Never commit .env.

# development | test | production   (production hides /docs and /openapi.json)
GATEZERO_ENVIRONMENT=development

# SQLAlchemy URL using the psycopg 3 driver.
GATEZERO_DATABASE_URL=postgresql+psycopg://gatezero_app:CHANGE_ME@localhost:5432/gatezero

# Server-side secret mixed into every API-key hash (HMAC key). At least 32 characters.
# Generate one with:  uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every issued API key.
GATEZERO_API_KEY_PEPPER=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS

# Maximum accepted request body for POST /v1/tool-calls, in bytes.
GATEZERO_MAX_REQUEST_BYTES=16384

# Only read by the test suite. MUST point at a separate database whose name ends in _test,
# because the tests wipe its tables.
GATEZERO_TEST_DATABASE_URL=postgresql+psycopg://gatezero_app:CHANGE_ME@localhost:5432/gatezero_test
